// Screens: screen 0 = menu/download, 1 = update (no TabWidget).
// Contract: existing property/callback names preserved; update_tab removed.
// Slint 1.x - dark theme, fluent style, accent #7C5CFF (colors unchanged).

import { Button, LineEdit, ComboBox, ProgressIndicator, ScrollView, Palette } from "std-widgets.slint";

// Dark theme rounded card (natural height: does not stretch with window).
component Card inherits Rectangle {
    background: #1d1d27;
    border-radius: 10px;
    border-width: 1px;
    border-color: #2e2e3a;
    vertical-stretch: 0;

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        @children
    }
}

// Alert button (red) for destructive actions.
component AlertButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;

    callback clicked;

    min-width: 96px;
    min-height: 26px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? #5a2a2a : touch.pressed ? #cc4444 : touch.has-hover ? #ff6b61 : #e05555;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            text: root.text;
            color: root.enabled ? white : #8a8a95;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Primary button with #7C5CFF accent.
component AccentButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;

    callback clicked;

    min-width: 96px;
    min-height: 26px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? #3a3a46 : touch.pressed ? #6a4de0 : touch.has-hover ? #8f74ff : #7c5cff;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            text: root.text;
            color: root.enabled ? white : #8a8a95;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Compact segmented control (Format, Content).
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current: 0;
    in property <bool> enabled: true;

    background: #101018;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2e2e3a;
    min-height: 26px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    HorizontalLayout {
        spacing: 2px;
        padding: 2px;
        for opt[i] in root.options: Rectangle {
            background: i == root.current ? #7c5cff : transparent;
            border-radius: 4px;
            min-width: 68px;
            Text {
                text: opt;
                color: root.enabled ? white : #8a8a95;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: root.enabled;
                clicked => { root.current = i; }
            }
        }
    }
}

// Status badge (0 green, 1 yellow, 2 red, 3 gray).
component Badge inherits Rectangle {
    in property <int> kind;
    in property <string> label;

    min-height: 24px;
    border-radius: 12px;
    background: root.kind == 0 ? #1e6b38 : root.kind == 1 ? #8a6d00 : root.kind == 2 ? #a0231b : #4d4d59;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: white;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    // ---- Navigation ----
    in-out property <int> screen: 0;         // 0 = menu/download, 1 = update
    in-out property <bool> show_log: false;  // collapsible log (hidden by default)
    in property <string> missing_tools_msg: "";
    in property <bool> analysis_ok: false;

    // ---- Download (main screen) ----
    in-out property <string> url: "";
    in-out property <string> output_dir: "";
    in-out property <int> resolution_index: 0;
    in property <[string]> resolutions: [];
    in property <string> video_title: "";
    in property <string> duration: "";
    in property <image> thumbnail;          // placeholder until thumbnail arrives
    in-out property <int> mode: 0;          // 0 = full, 1 = clip
    in-out property <string> start_t: "";   // HH:MM:SS or MM:SS
    in-out property <string> end_t: "";
    in-out property <int> container: 0;     // 0 = MKV, 1 = MP4
    in property <string> dl_state: "idle";  // idle|analyzing|ready|downloading|cutting|converting|finalizing|done|error
    in property <float> dl_percent: 0;      // 0..100
    in-out property <string> dl_error: "";
    in property <string> dl_final: "";      // final file path (when done)
    in property <[string]> log_lines: [];

    // ---- Update (update screen) ----
    in property <string> ytdlp_installed: "-";
    in property <string> ytdlp_latest: "-";
    in property <int> ytdlp_badge: 3;       // 0 ok, 1 update available, 2 not installed, 3 unknown
    in property <string> ffmpeg_installed: "-";
    in property <string> ffmpeg_latest: "-";
    in property <int> ffmpeg_badge: 3;
    in property <bool> upd_busy: false;
    in property <float> upd_percent: 0;     // 0..100
    in property <string> upd_msg: "";
    in property <string> upd_summary: "";
    in-out property <bool> delete_confirm: false;

    // ---- Callbacks (UI -> Rust) ----
    callback analyze();
    callback pick_folder();
    callback start_download();
    callback cancel_download();
    callback open_folder();
    callback new_download();
    callback view_log();      // toggle in-app log panel
    callback check_updates();
    callback run_update(int); // bitmask: 1 yt-dlp, 2 ffmpeg, 3 both
    callback confirm_delete();
    callback delete_binaries();

    // Validation error clears automatically when options are modified.
    changed output_dir => { root.dl_error = ""; }
    changed mode => { root.dl_error = ""; }
    changed start_t => { root.dl_error = ""; }
    changed end_t => { root.dl_error = ""; }
    changed resolution_index => { root.dl_error = ""; }

    title: "Youtube Downloader";
    icon: @image-url("../assets/icon.png");
    preferred-width: 820px;
    preferred-height: 660px;
    min-width: 720px;
    min-height: 660px;

    // State helper properties.
    property <bool> is-busy: root.dl_state == "analyzing" || root.dl_state == "downloading" || root.dl_state == "cutting" || root.dl_state == "converting" || root.dl_state == "finalizing";
    property <bool> is-working: root.dl_state == "downloading" || root.dl_state == "cutting" || root.dl_state == "converting" || root.dl_state == "finalizing";
    property <bool> is-finished: root.dl_state == "done" || root.dl_state == "error";
    property <bool> can-analyze: root.url != "" && (root.dl_state == "idle" || root.dl_state == "ready" || root.dl_state == "done" || root.dl_state == "error");
    property <bool> can-download: root.analysis_ok && root.output_dir != "" && root.resolutions.length > 0 && (root.mode == 0 || (root.start_t != "" && root.end_t != ""));
    property <bool> update-available: root.ytdlp_badge == 1 || root.ytdlp_badge == 2 || root.ffmpeg_badge == 1 || root.ffmpeg_badge == 2;
    property <string> stage-text: root.dl_state == "analyzing" ? "Analyzing link…" : root.dl_state == "ready" ? "Ready to download" : root.dl_state == "downloading" ? "Downloading…" : root.dl_state == "cutting" ? "Cutting clip…" : root.dl_state == "converting" ? "Converting…" : root.dl_state == "finalizing" ? "Finalizing…" : root.dl_state == "done" ? "Completed" : root.dl_state == "error" ? "Error" : "Idle";

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // ================= MAIN SCREEN =================
        if root.screen == 0: VerticalLayout {
            spacing: 2px;

            Card {
                height: 96px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Video Link";
                        font-size: 13px;
                        font-weight: 600;
                        color: #c9cede;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Badge {
                        kind: 1;
                        label: "New version";
                        visible: root.update-available;
                    }
                    Button {
                        text: "Update";
                        height: 32px;
                        enabled: !root.is-busy;
                        clicked => { root.screen = 1; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    url-edit := LineEdit {
                        text <=> root.url;
                        height: 34px;
                        placeholder-text: "Paste YouTube link here…";
                        enabled: !root.is-busy;
                        accepted => { root.analyze(); }
                    }
                    AccentButton {
                        text: "Analyze";
                        height: 34px;
                        enabled: root.can-analyze;
                        clicked => { root.analyze(); }
                    }
                }
            }

            // --- Video: thumbnail + title + duration ---
            Card {
                height: 218px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: root.show_log ? 160px : 208px;
                        height: root.show_log ? 90px : 117px;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        background: #101018;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #2e2e3a;
                        clip: true;
                        Image {
                            source: root.thumbnail;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                    }
                }
                Text {
                    text: root.video_title == "" ? "No video analyzed yet" : root.video_title;
                    font-size: 15px;
                    font-weight: 700;
                    color: root.video_title == "" ? #8a8a95 : white;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    max-height: 44px;
                    overflow: clip;
                }
                Text {
                    text: "Duration: " + (root.duration == "" ? "--:--:--" : root.duration);
                    font-size: 12px;
                    color: #9aa0b4;
                    horizontal-alignment: center;
                }
            }

            // --- Options: hidden while log is open (options are locked during
            // download anyway; keeps everything on screen with no scroll) ---
            if !root.show_log: Card {
                height: 168px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Quality:";
                        width: 80px;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: #c9cede;
                    }
                    res-combo := ComboBox {
                        model: root.resolutions;
                        height: 34px;
                        current-index <=> root.resolution_index;
                        enabled: root.resolutions.length > 0 && !root.is-busy;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Format:";
                        width: 70px;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: #c9cede;
                    }
                    Segmented {
                        options: ["MKV", "MP4"];
                        current <=> root.container;
                        enabled: !root.is-busy;
                    }
                    Text {
                        text: "Content:";
                        width: 70px;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: #c9cede;
                    }
                    Segmented {
                        options: ["Full", "Clip"];
                        current <=> root.mode;
                        enabled: !root.is-busy;
                    }
                    LineEdit {
                        text <=> root.start_t;
                        placeholder-text: "Start";
                        height: 30px;
                        enabled: root.mode == 1 && !root.is-busy;
                        horizontal-stretch: 0;
                        min-width: 88px;
                        max-width: 88px;
                    }
                    Text {
                        text: "to";
                        vertical-alignment: center;
                        font-size: 12px;
                        color: #9aa0b4;
                    }
                    LineEdit {
                        text <=> root.end_t;
                        placeholder-text: "End";
                        height: 30px;
                        enabled: root.mode == 1 && !root.is-busy;
                        horizontal-stretch: 0;
                        min-width: 88px;
                        max-width: 88px;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Folder:";
                        width: 80px;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: #c9cede;
                    }
                    Button {
                        text: "Browse…";
                        height: 34px;
                        clicked => { root.pick_folder(); }
                    }
                    Text {
                        text: root.output_dir == "" ? "No folder selected" : root.output_dir;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: root.output_dir == "" ? #8a8a95 : #c9cede;
                        overflow: elide;
                    }
                }
            }

            // --- Progress + stage (fixed height; absorbs no stretch) ---
            Card {
                height: 76px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.stage-text;
                        horizontal-stretch: 1;
                        font-size: 13px;
                        font-weight: 600;
                        color: #7c5cff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: Math.round(root.dl_percent) + "%";
                        font-size: 13px;
                        color: #c9cede;
                        vertical-alignment: center;
                    }
                }
                ProgressIndicator {
                    progress: root.dl_percent / 100;
                    indeterminate: root.dl_state == "analyzing";
                }
                if root.dl_error != "": Text {
                    text: root.dl_error;
                    color: #ff6b61;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.dl_state == "done" && root.dl_final != "": Text {
                    text: "File: " + root.dl_final;
                    color: #7fd08a;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // --- Log (below progress, only when visible) ---
            if root.show_log: Card {
                Text {
                    text: "Log";
                    font-size: 13px;
                    font-weight: 600;
                    color: #c9cede;
                }
                ScrollView {
                    height: 70px;
                    vertical-stretch: 0;
                    VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        for line in root.log_lines: Text {
                            text: line;
                            font-size: 12px;
                            color: #c9cede;
                        }
                    }
                }
            }

            // --- Actions: secondary on left, Download on right ---
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Cancel";
                    width: 104px; height: 30px;
                    enabled: root.is-working;
                    clicked => { root.cancel_download(); }
                }
                Button {
                    text: "Open folder";
                    width: 104px; height: 30px;
                    enabled: root.output_dir != "";
                    clicked => { root.open_folder(); }
                }
                Button {
                    text: "New";
                    width: 104px; height: 30px;
                    enabled: root.is-finished;
                    clicked => { root.new_download(); }
                }
                Button {
                    text: root.show_log ? "Hide log" : "View log";
                    width: 104px; height: 30px;
                    enabled: root.log_lines.length > 0;
                    clicked => { root.view_log(); }
                }
                Rectangle { horizontal-stretch: 1; }
                AccentButton {
                    text: "Download";
                    min-width: 112px;
                    height: 32px;
                    enabled: root.can-download && !root.is-busy;
                    clicked => { root.start_download(); }
                }
            }
            // Spacer: absorbs excess height in taller windows (content stays put).
            Rectangle { vertical-stretch: 1; }
        }

        // ================= UPDATE SCREEN =================
        if root.screen == 1: VerticalLayout {
            spacing: 10px;

            // --- Header with back button ---
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "← Back";
                    clicked => { root.screen = 0; }
                }
                Text {
                    text: "Update";
                    font-size: 15px;
                    font-weight: 700;
                    color: white;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            Text {
                text: root.missing_tools_msg;
                color: #ff6b61;
                font-size: 12px;
                wrap: word-wrap;
                visible: root.missing_tools_msg != "";
            }

            // --- Versions table ---
            Card {
                Text {
                    text: "Installed vs Available Versions";
                    font-size: 13px;
                    font-weight: 600;
                    color: #c9cede;
                }
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Component"; width: 90px; font-weight: 600; color: #9aa0b4; font-size: 12px; }
                        Text { text: "Installed"; width: 140px; font-weight: 600; color: #9aa0b4; font-size: 12px; }
                        Text { text: "Latest"; width: 140px; font-weight: 600; color: #9aa0b4; font-size: 12px; }
                        Text { text: "Status"; horizontal-stretch: 1; font-weight: 600; color: #9aa0b4; font-size: 12px; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "yt-dlp"; width: 90px; font-size: 13px; color: white; vertical-alignment: center; }
                        Text { text: root.ytdlp_installed; width: 140px; font-size: 12px; color: #c9cede; vertical-alignment: center; }
                        Text { text: root.ytdlp_latest; width: 140px; font-size: 12px; color: #c9cede; vertical-alignment: center; }
                        Badge {
                            kind: root.ytdlp_badge;
                            label: root.ytdlp_badge == 0 ? "Up to date" : root.ytdlp_badge == 1 ? "Update available" : root.ytdlp_badge == 2 ? "Not installed" : "Unknown";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "FFmpeg"; width: 90px; font-size: 13px; color: white; vertical-alignment: center; }
                        Text { text: root.ffmpeg_installed; width: 140px; font-size: 12px; color: #c9cede; vertical-alignment: center; }
                        Text { text: root.ffmpeg_latest; width: 140px; font-size: 12px; color: #c9cede; vertical-alignment: center; }
                        Badge {
                            kind: root.ffmpeg_badge;
                            label: root.ffmpeg_badge == 0 ? "Up to date" : root.ffmpeg_badge == 1 ? "Update available" : root.ffmpeg_badge == 2 ? "Not installed" : "Unknown";
                        }
                    }
                }
            }

            // --- Update actions ---
            Card {
                VerticalLayout {
                    spacing: 8px;
                    Button {
                        text: "Update yt-dlp";
                        width: 100%;
                        height: 36px;
                        enabled: !root.upd_busy && !(root.ytdlp_badge == 0 && root.ffmpeg_badge == 0);
                        clicked => { root.run_update(1); }
                    }
                    Button {
                        text: "Update FFmpeg";
                        width: 100%;
                        height: 36px;
                        enabled: !root.upd_busy && !(root.ytdlp_badge == 0 && root.ffmpeg_badge == 0);
                        clicked => { root.run_update(2); }
                    }
                    AccentButton {
                        text: "Update all";
                        width: 100%;
                        height: 36px;
                        enabled: !root.upd_busy && !(root.ytdlp_badge == 0 && root.ffmpeg_badge == 0);
                        clicked => { root.run_update(3); }
                    }
                    AlertButton {
                        text: "Delete binaries";
                        width: 100%;
                        height: 36px;
                        enabled: !root.upd_busy && (root.ytdlp_badge != 3 || root.ffmpeg_badge != 3);
                        clicked => { root.confirm_delete(); }
                    }
                    Button {
                        text: root.upd_busy ? "Checking..." : "Check for updates";
                        width: 100%;
                        height: 36px;
                        enabled: !root.upd_busy;
                        clicked => { root.check_updates(); }
                    }
                    if root.upd_msg != "": Text {
                        text: root.upd_msg;
                        color: root.upd_busy ? #7c5cff : #7fd08a;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                    if root.delete_confirm: HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Confirm deletion of binaries?"; color: #ff6b61; }
                        Button { text: "Confirm"; clicked => { root.delete_binaries(); } }
                        Button { text: "Cancel"; clicked => { root.delete_confirm = false; } }
                    }
                }
            }

            // --- Progress + summary ---
            Card {
                vertical-stretch: 1;
                Text {
                    text: "Progress";
                    font-size: 13px;
                    font-weight: 600;
                    color: #c9cede;
                }
                ProgressIndicator {
                    progress: root.upd_percent / 100;
                }
                Text {
                    text: root.upd_summary;
                    font-size: 12px;
                    color: #c9cede;
                    wrap: word-wrap;
                    visible: root.upd_summary != "";
                }
            }
        }
    }
}
