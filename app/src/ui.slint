// Telas: screen 0 = menu/download, 1 = atualizar (sem TabWidget).
// Contrato: nomes de propriedades/callbacks existentes mantidos; update_tab removida.
// Slint 1.x - tema dark, estilo fluent, acento #7C5CFF (cores inalteradas).

import { Button, LineEdit, ComboBox, ProgressIndicator, ScrollView, Palette } from "std-widgets.slint";

// Card arredondado do tema dark (altura natural: nao estica com a janela).
component Card inherits Rectangle {
    background: #1d1d27;
    border-radius: 10px;
    border-width: 1px;
    border-color: #2e2e3a;
    vertical-stretch: 0;

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        @children
    }
}

// Botao primario com o acento #7C5CFF (o Button primary do fluent usa o azul padrao).
component AccentButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;

    callback clicked;

    min-width: 96px;
    min-height: 26px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? #3a3a46 : touch.pressed ? #6a4de0 : touch.has-hover ? #8f74ff : #7c5cff;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            text: root.text;
            color: root.enabled ? white : #8a8a95;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Controle segmentado compacto (Formato, Conteudo).
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current: 0;
    in property <bool> enabled: true;

    background: #101018;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2e2e3a;
    min-height: 26px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    HorizontalLayout {
        spacing: 2px;
        padding: 2px;
        for opt[i] in root.options: Rectangle {
            background: i == root.current ? #7c5cff : transparent;
            border-radius: 4px;
            min-width: 68px;
            Text {
                text: opt;
                color: root.enabled ? white : #8a8a95;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: root.enabled;
                clicked => { root.current = i; }
            }
        }
    }
}

// Badge de status (0 verde, 1 amarelo, 2 vermelho, 3 cinza).
component Badge inherits Rectangle {
    in property <int> kind;
    in property <string> label;

    min-height: 24px;
    border-radius: 12px;
    background: root.kind == 0 ? #1e6b38 : root.kind == 1 ? #8a6d00 : root.kind == 2 ? #a0231b : #4d4d59;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: white;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    // ---- Navegacao ----
    in-out property <int> screen: 0;         // 0 = menu/download, 1 = atualizar
    in-out property <bool> show_log: false;  // log colapsavel (oculto por padrao)
    in property <string> missing_tools_msg: "";
    in property <bool> analysis_ok: false;

    // ---- Download (tela inicial) ----
    in-out property <string> url: "";
    in-out property <string> output_dir: "";
    in-out property <int> resolution_index: 0;
    in property <[string]> resolutions: [];
    in property <string> video_title: "";
    in property <string> duration: "";
    in property <image> thumbnail;          // placeholder ate a miniatura chegar
    in-out property <int> mode: 0;          // 0 = completo, 1 = trecho
    in-out property <string> start_t: "";   // HH:MM:SS ou MM:SS
    in-out property <string> end_t: "";
    in-out property <int> container: 0;     // 0 = MKV, 1 = MP4
    in property <string> dl_state: "idle";  // idle|analyzing|ready|downloading|cutting|converting|finalizing|done|error
    in property <float> dl_percent: 0;      // 0..100
    in-out property <string> dl_error: "";
    in property <string> dl_final: "";      // caminho do arquivo final (quando done)
    in property <[string]> log_lines: [];

    // ---- Atualizar (tela de update) ----
    in property <string> ytdlp_installed: "-";
    in property <string> ytdlp_latest: "-";
    in property <int> ytdlp_badge: 3;       // 0 ok, 1 update disponivel, 2 nao instalado, 3 desconhecido
    in property <string> ffmpeg_installed: "-";
    in property <string> ffmpeg_latest: "-";
    in property <int> ffmpeg_badge: 3;
    in property <bool> upd_busy: false;
    in property <float> upd_percent: 0;     // 0..100
    in property <string> upd_msg: "";
    in property <string> upd_summary: "";

    // ---- Callbacks (UI -> Rust) ----
    callback analyze();
    callback pick_folder();
    callback start_download();
    callback cancel_download();
    callback open_folder();
    callback new_download();
    callback view_log();      // toggle do painel de log in-app
    callback check_updates();
    callback run_update(int); // bitmask: 1 yt-dlp, 2 ffmpeg, 3 ambos

    // Erro de validacao some sozinho ao corrigir as opcoes.
    changed output_dir => { root.dl_error = ""; }
    changed mode => { root.dl_error = ""; }
    changed start_t => { root.dl_error = ""; }
    changed end_t => { root.dl_error = ""; }
    changed resolution_index => { root.dl_error = ""; }

    title: "Youtube Downloader";
    icon: @image-url("../assets/icon.png");
    preferred-width: 820px;
    preferred-height: 700px;
    min-width: 720px;
    min-height: 700px;

    // Helpers de estado (privados, fora do contrato).
    property <bool> is-busy: root.dl_state == "analyzing" || root.dl_state == "downloading" || root.dl_state == "cutting" || root.dl_state == "converting" || root.dl_state == "finalizing";
    property <bool> is-working: root.dl_state == "downloading" || root.dl_state == "cutting" || root.dl_state == "converting" || root.dl_state == "finalizing";
    property <bool> is-finished: root.dl_state == "done" || root.dl_state == "error";
    property <bool> can-analyze: root.url != "" && (root.dl_state == "idle" || root.dl_state == "ready" || root.dl_state == "done" || root.dl_state == "error");
    // Botao Baixar reage as opcoes na hora (item 1): nao depende mais de dl_state.
    property <bool> can-download: root.analysis_ok && root.output_dir != "" && root.resolutions.length > 0 && (root.mode == 0 || (root.start_t != "" && root.end_t != ""));
    property <bool> update-available: root.ytdlp_badge == 1 || root.ytdlp_badge == 2 || root.ffmpeg_badge == 1 || root.ffmpeg_badge == 2;
    property <string> stage-text: root.dl_state == "analyzing" ? "Analisando link…" : root.dl_state == "ready" ? "Pronto para baixar" : root.dl_state == "downloading" ? "Baixando…" : root.dl_state == "cutting" ? "Cortando trecho…" : root.dl_state == "converting" ? "Convertendo…" : root.dl_state == "finalizing" ? "Finalizando…" : root.dl_state == "done" ? "Concluído" : root.dl_state == "error" ? "Erro" : "Ocioso";

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // ================= TELA INICIAL =================
        // `if` remove a tela do layout de verdade. `visible` mantinha o espaco
        // e empurrava a outra tela para fora (= tela preta). Ids internos
        // (url-edit, res-combo) nao tem referencia externa: seguro.
        if root.screen == 0: VerticalLayout {
            spacing: 2px;

            // (Sem ScrollView e sem header separado: tudo deve caber na janela;
            // header fundido na linha de titulo do card URL.)
            Card {
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Link do vídeo";
                        font-size: 13px;
                        font-weight: 600;
                        color: #c9cede;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Badge {
                        kind: 1;
                        label: "Nova versão";
                        visible: root.update-available;
                    }
                    Button {
                        text: "Atualizar binários";
                        enabled: !root.is-busy;
                        clicked => { root.screen = 1; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    url-edit := LineEdit {
                        text <=> root.url;
                        placeholder-text: "Cole aqui a URL do YouTube…";
                        enabled: !root.is-busy;
                        accepted => { root.analyze(); }
                    }
                    AccentButton {
                        text: "Analisar";
                        enabled: root.can-analyze;
                        clicked => { root.analyze(); }
                    }
                }
            }

            // --- Video: thumbnail + titulo + duracao (SEMPRE visivel) ---
            Card {
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 208px;
                        height: 117px;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        background: #101018;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #2e2e3a;
                        clip: true;
                        Image {
                            source: root.thumbnail;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                    }
                }
                Text {
                    text: root.video_title == "" ? "Nenhum vídeo analisado ainda" : root.video_title;
                    font-size: 15px;
                    font-weight: 700;
                    color: root.video_title == "" ? #8a8a95 : white;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    max-height: 44px;
                    overflow: clip;
                }
                Text {
                    text: "Duração: " + (root.duration == "" ? "--:--:--" : root.duration);
                    font-size: 12px;
                    color: #9aa0b4;
                    horizontal-alignment: center;
                }
            }

            // --- Opcoes: qualidade, formato, conteudo/trecho, pasta ---
            Card {
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Qualidade:";
                        width: 80px;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: #c9cede;
                    }
                    res-combo := ComboBox {
                        model: root.resolutions;
                        current-index <=> root.resolution_index;
                        enabled: root.resolutions.length > 0 && !root.is-busy;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Formato:";
                        width: 80px;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: #c9cede;
                    }
                    Segmented {
                        options: ["MKV", "MP4"];
                        current <=> root.container;
                        enabled: !root.is-busy;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Conteúdo:";
                        width: 80px;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: #c9cede;
                    }
                    Segmented {
                        options: ["Completo", "Trecho"];
                        current <=> root.mode;
                        enabled: !root.is-busy;
                    }
                    LineEdit {
                        text <=> root.start_t;
                        placeholder-text: "Início";
                        enabled: root.mode == 1 && !root.is-busy;
                        horizontal-stretch: 0;
                        min-width: 96px;
                        max-width: 96px;
                    }
                    Text {
                        text: "até";
                        vertical-alignment: center;
                        font-size: 12px;
                        color: #9aa0b4;
                    }
                    LineEdit {
                        text <=> root.end_t;
                        placeholder-text: "Fim";
                        enabled: root.mode == 1 && !root.is-busy;
                        horizontal-stretch: 0;
                        min-width: 96px;
                        max-width: 96px;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Pasta:";
                        width: 80px;
                        vertical-alignment: center;
                        font-size: 13px;
                        color: #c9cede;
                    }
                    Button {
                        text: "Escolher…";
                        clicked => { root.pick_folder(); }
                    }
                    Text {
                        text: root.output_dir == "" ? "Nenhuma pasta escolhida" : root.output_dir;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: root.output_dir == "" ? #8a8a95 : #c9cede;
                        overflow: elide;
                    }
                }
            }

            // --- Progresso + etapa ---
            Card {
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.stage-text;
                        horizontal-stretch: 1;
                        font-size: 13px;
                        font-weight: 600;
                        color: #7c5cff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: Math.round(root.dl_percent) + "%";
                        font-size: 13px;
                        color: #c9cede;
                        vertical-alignment: center;
                    }
                }
                ProgressIndicator {
                    progress: root.dl_percent / 100;
                    indeterminate: root.dl_state == "analyzing";
                }
                if root.dl_error != "": Text {
                    text: root.dl_error;
                    color: #ff6b61;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.dl_state == "done" && root.dl_final != "": Text {
                    text: "Arquivo: " + root.dl_final;
                    color: #7fd08a;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // --- Log (abaixo do progresso, so quando visivel) ---
            if root.show_log: Card {
                Text {
                    text: "Log";
                    font-size: 13px;
                    font-weight: 600;
                    color: #c9cede;
                }
                ScrollView {
                    height: 110px;
                    vertical-stretch: 0;
                    content-y: min(0px, self.visible-height - self.content-height);
                    VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        for line in root.log_lines: Text {
                            text: line;
                            font-size: 12px;
                            color: #c9cede;
                        }
                    }
                }
            }

            // --- Acoes: secundarios a esquerda, Baixar a direita ---
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Cancelar";
                    width: 104px; height: 30px;
                    enabled: root.is-working;
                    clicked => { root.cancel_download(); }
                }
                Button {
                    text: "Abrir pasta";
                    width: 104px; height: 30px;
                    enabled: root.output_dir != "";
                    clicked => { root.open_folder(); }
                }
                Button {
                    text: "Novo";
                    width: 104px; height: 30px;
                    enabled: root.is-finished;
                    clicked => { root.new_download(); }
                }
                Button {
                    text: root.show_log ? "Ocultar log" : "Ver log";
                    width: 104px; height: 30px;
                    enabled: root.log_lines.length > 0;
                    clicked => { root.view_log(); }
                }
                Rectangle { horizontal-stretch: 1; }
                AccentButton {
                    text: "Baixar";
                    min-width: 112px;
                    enabled: root.can-download && !root.is-busy;
                    clicked => { root.start_download(); }
                }
            }
        }

        // ================= TELA ATUALIZAR =================
        if root.screen == 1: VerticalLayout {
            spacing: 10px;

            // --- Header com voltar ---
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "← Voltar";
                    clicked => { root.screen = 0; }
                }
                Text {
                    text: "Atualizar binários";
                    font-size: 15px;
                    font-weight: 700;
                    color: white;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            Text {
                text: root.missing_tools_msg;
                color: #ff6b61;
                font-size: 12px;
                wrap: word-wrap;
                visible: root.missing_tools_msg != "";
            }

            // --- Tabela de versoes ---
            Card {
                Text {
                    text: "Versões instaladas x disponíveis";
                    font-size: 13px;
                    font-weight: 600;
                    color: #c9cede;
                }
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Componente"; width: 90px; font-weight: 600; color: #9aa0b4; font-size: 12px; }
                        Text { text: "Instalada"; width: 140px; font-weight: 600; color: #9aa0b4; font-size: 12px; }
                        Text { text: "Mais recente"; width: 140px; font-weight: 600; color: #9aa0b4; font-size: 12px; }
                        Text { text: "Status"; horizontal-stretch: 1; font-weight: 600; color: #9aa0b4; font-size: 12px; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "yt-dlp"; width: 90px; font-size: 13px; color: white; vertical-alignment: center; }
                        Text { text: root.ytdlp_installed; width: 140px; font-size: 12px; color: #c9cede; vertical-alignment: center; }
                        Text { text: root.ytdlp_latest; width: 140px; font-size: 12px; color: #c9cede; vertical-alignment: center; }
                        Badge {
                            kind: root.ytdlp_badge;
                            label: root.ytdlp_badge == 0 ? "Atualizado" : root.ytdlp_badge == 1 ? "Atualização disponível" : root.ytdlp_badge == 2 ? "Não instalado" : "Desconhecido";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "FFmpeg"; width: 90px; font-size: 13px; color: white; vertical-alignment: center; }
                        Text { text: root.ffmpeg_installed; width: 140px; font-size: 12px; color: #c9cede; vertical-alignment: center; }
                        Text { text: root.ffmpeg_latest; width: 140px; font-size: 12px; color: #c9cede; vertical-alignment: center; }
                        Badge {
                            kind: root.ffmpeg_badge;
                            label: root.ffmpeg_badge == 0 ? "Atualizado" : root.ffmpeg_badge == 1 ? "Atualização disponível" : root.ffmpeg_badge == 2 ? "Não instalado" : "Desconhecido";
                        }
                    }
                }
            }

            // --- Acoes de update ---
            Card {
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Button {
                        text: "Verificar";
                        enabled: !root.upd_busy;
                        clicked => { root.check_updates(); }
                    }
                    Button {
                        text: "yt-dlp";
                        enabled: !root.upd_busy;
                        clicked => { root.run_update(1); }
                    }
                    Button {
                        text: "FFmpeg";
                        enabled: !root.upd_busy;
                        clicked => { root.run_update(2); }
                    }
                    AccentButton {
                        text: "Ambos";
                        enabled: !root.upd_busy;
                        clicked => { root.run_update(3); }
                    }
                }
            }

            // --- Progresso + resumo ---
            Card {
                vertical-stretch: 1;
                Text {
                    text: "Progresso";
                    font-size: 13px;
                    font-weight: 600;
                    color: #c9cede;
                }
                ProgressIndicator {
                    progress: root.upd_percent / 100;
                }
                Text {
                    text: root.upd_msg;
                    font-size: 12px;
                    color: #9aa0b4;
                    wrap: word-wrap;
                    visible: root.upd_msg != "";
                }
                Text {
                    text: root.upd_summary;
                    font-size: 12px;
                    color: #c9cede;
                    wrap: word-wrap;
                    visible: root.upd_summary != "";
                }
            }
        }
    }
}
